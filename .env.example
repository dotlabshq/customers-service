PORT=3008
FOLDBASE_URL=http://127.0.0.1:3400

# Realm token verification. JWT_SECRET is the legacy HS256 path, accepted while
# it is set; a realm on ES256 sets AUTH_JWKS_URI instead.
JWT_SECRET=dev-secret-change-me-32-chars-min
# AUTH_JWKS_URI=http://127.0.0.1:3003/.well-known/jwks.json
# AUTH_ISSUER=http://localhost:8080
# AUTH_AUDIENCE=baseworks-local

# org-service is the PDP. Every request names an org in X-Org-Id and this
# service asks org-service whether the caller is a member before touching
# anything — customers are org-scoped, and the org id is the foldbase tenant.
ORG_SERVICE_URL=http://127.0.0.1:3006
